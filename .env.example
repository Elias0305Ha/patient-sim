# Copy to .env and fill in. .env is gitignored and must never be committed.

# --- Twilio ---
# From https://console.twilio.com (Account Info panel)
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=

# The ONE number all test calls originate from, E.164 (e.g. +18055551234).
# Pretty Good AI grades call quality by looking up this number.
# Buy it once, put it here, and never change it.
TWILIO_FROM_NUMBER=

# --- Target ---
# The assessment test line. This is the only number this project ever dials.
# Asserted before every call; do not change it.
TARGET_NUMBER=+18054398008

# --- OpenAI ---
# Needs Realtime API access and account credit.
OPENAI_API_KEY=

# --- Local tunnel ---
# Public wss:// base that Twilio dials back into, no trailing slash.
# From `ngrok http 8080` — the https URL with the scheme swapped to wss.
# Changes every time the tunnel restarts.
PUBLIC_WSS_BASE=

# Local port the bridge websocket server listens on. Must match the ngrok port.
WS_PORT=8080
